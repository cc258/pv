# ===========================
# PV - Video Platform .gitignore
# 三段式：Python 后端 / 前端 & Node / 全局与部署
# ===========================

# ===========================
# 一、Python / FastAPI 后端 （backend/）
# ===========================

# --- Python 字节码 / DLL ---
__pycache__/
*.py[codz]
*$py.class
*.so

# --- 打包 / 构建产物 ---
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- PyInstaller ---
*.manifest
*.spec

# --- 安装日志 ---
pip-log.txt
pip-delete-this-directory.txt

# --- 测试 / 覆盖率报告 ---
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
dmypy.json
.dmypy.json

# --- 翻译 ---
*.mo
*.pot

# --- Django/Flask 通用 ---
*.log
local_settings.py
instance/
.webassets-cache

# --- Scrapy ---
.scrapy

# --- Sphinx / MkDocs ---
docs/_build/
/site

# --- PyBuilder ---
.pybuilder/
target/

# --- Jupyter Notebook / IPython ---
.ipynb_checkpoints
profile_default/
ipython_config.py

# --- Python 虚拟环境解释器版本选择 ---
# 保留在仓库根/backend 下可以让 uv/pyenv 选对 Python；
# 如果你的团队环境差异大、不想锁定版本，就取消下一行注释：
# .python-version

# --- 各类 Python 包管理器 ---
#   uv.lock / pyproject.toml 一定要提交（保证可复现）
#   Pipfile.lock/poetry.lock/pdm.lock/pixi.lock 按需决定
#   虚拟环境目录一律不提交
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
.pdm-python
.pdm-build/
.pixi/
__pypackages__/
# Pipfile.lock  # 团队使用 Pipenv 时取消注释
# poetry.lock   # 团队使用 Poetry 时取消注释
# poetry.toml
# pdm.lock
# pdm.toml
# pixi.lock
# uv.lock       ← 推荐提交；已在 backend/ 中跟踪，此处无需再管

# --- Celery ---
celerybeat-schedule
celerybeat.pid

# --- SageMath ---
*.sage.py

# --- Cython ---
cython_debug/

# --- Rope / Spyder 工程 ---
.ropeproject
.spyderproject
.spyproject

# --- PyPI / 凭证文件 ---
.pypirc

# --- 环境变量（含密钥！绝不能提交） ---
.env
.env.*
!.env.example
.envrc

# --- SQLite 数据库 ---
#   注意：本项目选择提交 backend/app/database.db 到仓库作为种子数据库；
#   因此不在这里忽略任何 *.db。运行时产生的 journal/wal/shm 是临时文件，仍需忽略。
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite3-journal

# ===========================
# 二、前端 / Node（admin/  web/）
# ===========================

# --- 包管理器依赖（本地安装）---
node_modules/
.pnpm-store/
.pnp/
.pnp.js
.pnp.cjs
.pnp.data.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn-integrity

# --- 构建产物 ---
dist/
dist-ssr/
dist-native/
build/
out/
output/
.vercel/
.netlify/
.svelte-kit/
.next/
.nuxt/
.uniapp/

# --- 运行时日志 ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Vite / Webpack 本地开发服务状态文件 ---
*.local
.vite/
.webpack/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.babel-cache/
.tsbuildinfo
*.tsbuildinfo

# ===========================
# 三、全局 / IDE / 操作系统
# ===========================

# --- macOS Finder / SpotLight / 资源库垃圾 ---
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# --- Windows ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/
*.lnk
Desktop.ini

# --- Linux ---
*~
.fuse_hidden*
.directory
.nfs*

# --- 编辑器 / IDE ---
# 说明：通常不提交 .vscode/.idea，但允许提交 extensions.json 告诉大家推荐插件
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp
*.swo
*~

# --- JetBrains 项目级派生文件（.idea 已全局忽略，这里再补可能的根级）---
*.iml
*.iws
*.ipr
out/

# --- Visual Studio 其他（本项目不需要但兜底）---
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- AI 编辑器（Cursor/Windsurf 等）---
.cursorignore
.cursorindexingignore
.windsurfrules

# --- Abstra 自动化框架 ---
.abstra/

# --- Marimo ---
marimo/_static/
marimo/_lsp/
__marimo__/

# ===========================
# 四、部署 / Docker
# ===========================
#   Dockerfile / docker-compose.yml 需要提交
#   本地 docker volume 挂载目录不要提交
.docker-data/
docker-data/
docker-compose.override.yml
docker-compose.local.yml
